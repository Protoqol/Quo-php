{
  "name"       : "protoqol/quo-php",
  "version"    : "2.0.0",
  "description": "Quo for PHP - requires Quo-Client.",
  "license"    : "GPL-3.0-only",
  "authors"    : [
    {
      "name" : "Protoqol",
      "email": "open-source@protoqol.nl"
    }
  ],
  "require"    : {
    "php"        : ">=7.1|>8.0",
    "ext-json"   : "*",
    "ext-iconv"  : "*",
    "ext-curl"   : "*",
    "ramsey/uuid": "^4.9"
  },
  "require-dev": {
    "phpunit/phpunit": "7.*|8.*|9.*|10.*|11.*|12.*|13.*"
  },
  "provide"    : {
    "ext-mbstring": "*"
  },
  "bin"        : [
    "bin/quo"
  ],
  "autoload"   : {
    "files": [
      "src/functions/quo.php",
      "src/Polyfill/polyfill.php",
      "src/Polyfill/Mbstring/bootstrap.php"
    ],
    "psr-4": {
      "Protoqol\\Quo\\": "src/"
    }
  }
}
