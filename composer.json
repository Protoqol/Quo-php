{
  "name"       : "protoqol/quo-php",
  "version"    : "0.1.3",
  "description": "Companion package for the Quo debugger.",
  "license"    : "LGPL-3.0-only",
  "authors"    : [
    {
      "name" : "Protoqol",
      "email": "open-source@protoqol.nl"
    }
  ],
  "require"    : {
    "php"        : ">=7.1",
    "ext-json"   : "*",
    "ext-curl"   : "*",
    "ramsey/uuid": "^3.8 || ^4.0"
  },
  "require-dev": {
    "phpunit/phpunit"          : "7.*|8.*|9.*|10.*|11.*|12.*|13.*",
    "squizlabs/php_codesniffer": "^3.11 || ^4.0",
    "donatj/mock-webserver"    : "^2.10"
  },
  "autoload"   : {
    "files": [
      "src/functions/quo.php"
    ],
    "psr-4": {
      "Protoqol\\Quo\\": "src/"
    }
  }
}
